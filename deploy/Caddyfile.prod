# 3m4 production Caddyfile. Mounted over the dev one by docker-compose.prod.yml.
# Caddy auto-issues Let's Encrypt certs once DNS points at this box.

{
	email dev.ace.93.03@gmail.com
	# On-demand TLS for customer custom domains (Phase 4):
	# on_demand_tls {
	# 	ask http://api:5000/api/domains/verify-tls
	# }
}

3m4.net {
	# --- API ---
	handle /api/* {
		reverse_proxy api:5000
	}

	# --- MCP (Streamable HTTP) for AI agents ---
	handle /mcp* {
		reverse_proxy mcp:3333
	}

	# --- Marketing + dashboard (Qwik SSR) --- same matcher as dev (see Caddyfile
	# comments there for why each path is listed).
	@web path / /info /info/* /blog /blog/* /projects /projects/* /sponsors /sponsors/* /login /login/* /signup /signup/* /logout /logout/* /dashboard /dashboard/* /settings /settings/* /build/* /assets/* /favicon.ico /favicon.svg /apple-touch-icon.png /icon-192.png /icon-512.png /og-image.png /robots.txt /sitemap.xml /manifest.json /service-worker.js *q-data.json
	handle @web {
		reverse_proxy web:3000
	}

	# --- Everything else on the apex is a short code (or special redirect) ---
	handle {
		reverse_proxy redirect:5001
	}
}

www.3m4.net {
	redir https://3m4.net{uri} permanent
}

app.3m4.net {
	# Dashboard calls the API same-origin (VITE_API_URL=/api).
	handle /api/* {
		reverse_proxy api:5000
	}

	# --- MCP (Streamable HTTP) for AI agents ---
	handle /mcp* {
		reverse_proxy mcp:3333
	}
	handle {
		reverse_proxy web:3000
	}
}

# ── Sibling stacks on the `edge` network ─────────────────────────────────────
# exp (feature flags): /opt/exp, deployed without its own Caddy. Container
# names are stable (compose project `exp`, one replica each).
exp.3m4.net {
	handle /api/* {
		reverse_proxy exp-api-1:5000
	}
	handle /mcp* {
		reverse_proxy exp-mcp-1:3333
	}
	handle {
		reverse_proxy exp-web-1:3000
	}
}

# retro (user feedback): /opt/retro, same pattern. /widget.js is embedded by
# third-party sites, so it is served cacheable and CORS-open.
retro.3m4.net {
	handle /api/* {
		reverse_proxy retro-api-1:5000
	}
	handle /mcp* {
		reverse_proxy retro-mcp-1:3333
	}
	@widget path /widget.js /widget/*
	handle @widget {
		header Cache-Control "public, max-age=300"
		header Access-Control-Allow-Origin "*"
		reverse_proxy retro-web-1:3000
	}
	handle {
		reverse_proxy retro-web-1:3000
	}
}

# metrics (web analytics): /opt/metrics, same pattern. /m.js is embedded by
# third-party sites, so it is served cacheable and CORS-open.
metrics.3m4.net {
	handle /api/* {
		reverse_proxy metrics-api-1:5000
	}
	handle /mcp* {
		reverse_proxy metrics-mcp-1:3333
	}
	@tracker path /m.js /m/*
	handle @tracker {
		header Cache-Control "public, max-age=3600"
		header Access-Control-Allow-Origin "*"
		reverse_proxy metrics-web-1:3000
	}
	handle {
		reverse_proxy metrics-web-1:3000
	}
}

# oops (error tracking): /opt/oops, same pattern. /o.js is the browser SDK
# embedded by third-party apps, so it is served cacheable and CORS-open.
oops.3m4.net {
	handle /api/* {
		reverse_proxy oops-api-1:5000
	}
	handle /mcp* {
		reverse_proxy oops-mcp-1:3333
	}
	@sdk path /o.js /o/*
	handle @sdk {
		header Cache-Control "public, max-age=3600"
		header Access-Control-Allow-Origin "*"
		reverse_proxy oops-web-1:3000
	}
	handle {
		reverse_proxy oops-web-1:3000
	}
}

# smart-docs (knowledge base): /opt/smart-docs, compose project `smart-docs`.
# One FastAPI container serves the API, the editor, /mcp and the public pages.
smart-docs.3m4.net {
	encode gzip
	reverse_proxy smart-docs-api-1:8000
}

# accounts (identity / SSO for every 3m4 app): /opt/accounts, compose project
# `accounts`. The JWKS and the avatars are fetched by every relying app;
# /session.js is embedded by the static sites, so it is served cacheable and
# CORS-open. Credentialed CORS for /api/* is handled by the API itself
# (ALLOWED_ORIGINS), not here.
accounts.3m4.net {
	handle /api/* {
		reverse_proxy accounts-api-1:5000
	}
	@apiRoot path /.well-known/* /avatars/* /healthz
	handle @apiRoot {
		reverse_proxy accounts-api-1:5000
	}
	@widget path /session.js
	handle @widget {
		header {
			Cache-Control "public, max-age=300"
			Access-Control-Allow-Origin "*"
			# defer: replace the upstream Cache-Control instead of adding a second one
			defer
		}
		reverse_proxy accounts-web-1:3000
	}
	handle {
		reverse_proxy accounts-web-1:3000
	}
}

# ── Static side apps ──────────────────────────────────────────────────────────
# Uncomment per app once its files are rsynced to /srv/static/<app> on the host
# and the /srv/static volume mount is enabled in docker-compose.prod.yml.
# DNS: add an A record per subdomain pointing at this server.
#
# info.3m4.net {
# 	root * /srv/static/info
# 	encode gzip
# 	file_server
# }
# bubbles.3m4.net {
# 	root * /srv/static/bubbles
# 	encode gzip
# 	file_server
# }
# kinegram.3m4.net {
# 	root * /srv/static/kinegram
# 	encode gzip
# 	file_server
# }

# wars (real-time strategy game): /opt/wars, same pattern. One Rust server
# answers REST, the WebSocket (/ws) and the browser build (/play/, a 6.7 MB wasm
# that compresses to about a third, hence encode).
wars.3m4.net {
	encode zstd gzip
	handle {
		reverse_proxy wars-server-1:8086
	}
}
