# 3m4 reverse proxy.
# Dev: single host on :8080. Prod: replace `:8080` with `3m4.net` and add the
# `app.3m4.net` block; Caddy auto-issues TLS. On-demand TLS (for customer custom
# domains) is wired but commented until Phase 4.

{
	# email you@example.com          # uncomment in prod for Let's Encrypt
	# On-demand TLS for customer custom domains (Phase 4):
	# on_demand_tls {
	# 	ask http://api:5000/api/domains/verify-tls
	# }
}

:8080 {
	# --- API ---
	handle /api/* {
		reverse_proxy api:5000
	}

	# --- MCP (Streamable HTTP) for AI agents ---
	handle /mcp* {
		reverse_proxy mcp:3333
	}

	# --- Marketing + dashboard (Qwik SSR) ---
	# Named content paths and app assets go to the web app. Each route lists both
	# the bare path and a `/*` variant so Qwik City's trailing-slash normalization
	# (e.g. /signup -> /signup/) still matches and does not fall through to the
	# short-code catch-all below. Single `path` matcher = OR across all args.
	# `*q-data.json` and the service worker are Qwik City SPA-navigation/runtime
	# files requested at arbitrary depths; route them to web so client-side nav
	# works (otherwise it 404s and silently degrades to full page loads).
	@web path / /info /info/* /blog /blog/* /projects /projects/* /sponsors /sponsors/* /login /login/* /signup /signup/* /logout /logout/* /dashboard /dashboard/* /settings /settings/* /build/* /assets/* /favicon.ico /favicon.svg /apple-touch-icon.png /icon-192.png /icon-512.png /robots.txt /sitemap.xml /manifest.json /service-worker.js *q-data.json
	handle @web {
		reverse_proxy web:3000
	}

	# --- Everything else on the apex is a short code (or special redirect) ---
	handle {
		reverse_proxy redirect:5001
	}
}

# ── Production example (uncomment, set your domain) ───────────────────────────
# 3m4.net {
# 	handle /api/* { reverse_proxy api:5000 }
# 	@web { path / /info* /blog* /projects* /sponsors* /build/* /assets/* /favicon.ico /robots.txt }
# 	handle @web { reverse_proxy web:3000 }
# 	handle { reverse_proxy redirect:5001 }
# }
# app.3m4.net {
# 	reverse_proxy web:3000
# }
