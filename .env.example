# ─── 3m4 environment ─────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.

# --- Core / database ---
DATABASE_URL=postgresql+psycopg://shortlink:shortlink@postgres:5432/shortlink
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Identity (accounts.3m4.net) ---
# Sessions are issued by the shared accounts service; this app only verifies
# them (CONTRACT.md "Auth"). ACCOUNTS_URL = public origin (JWT issuer, login
# redirects, the browser's session calls). ACCOUNTS_INTERNAL_URL = where the
# api container fetches the JWKS; on the shared `edge` docker network that is
# the accounts api container, locally and in production alike.
ACCOUNTS_URL=http://localhost:8085                  # https://accounts.3m4.net in prod
ACCOUNTS_INTERNAL_URL=http://accounts-api-1:5000
# Behind Caddy the Qwik server must trust X-Forwarded-Proto, or SSR builds http://
# URLs (login redirects, return_to) that accounts rejects. Set in prod; harmless locally.
PROTOCOL_HEADER=x-forwarded-proto

# --- Privacy ---
# Salt for hashing visitor IPs. We NEVER store raw IPs. Rotate => geo dedup resets.
IP_HASH_SALT=change-me-ip-salt

# --- URLs ---
APP_BASE_URL=http://localhost:8080          # apex: landing + short links
DASHBOARD_URL=http://localhost:8080         # app.3m4.net in prod
SHORT_DOMAIN=localhost:8080                 # used to render short URLs
SHORT_URL_SCHEME=http                       # https in prod; local Caddy is plain http

# --- Reserved redirect (also stored in DB seed) ---
RESUME_REDIRECT_URL=https://enrique-magallon.com

# --- Billing (RevenueCat). Self-host: set BILLING_ENABLED=false ---
BILLING_ENABLED=true
REVENUECAT_WEBHOOK_AUTH_TOKEN=change-me-webhook-token
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=

# --- PostHog (optional; no-ops if unset) ---
# Leave EMPTY locally and for self-host: no analytics calls, and feature flags
# resolve to their self-host values in packages/shared/feature_flags.json
# (everything on, site-building off). Set only in production, where PostHog
# is the control panel for flags.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Personal API key (scope: feature flags read) enables local evaluation of
# feature flags. Unset => flags use defaults from packages/shared/feature_flags.json.
POSTHOG_PERSONAL_API_KEY=
# Pin individual flags from the environment, beating both PostHog and the
# self-host defaults. Comma-separated key=on|off, e.g. to preview the curtain
# locally: FEATURE_FLAG_OVERRIDES=site-building=on,signups=off
FEATURE_FLAG_OVERRIDES=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_PUBLIC_API=60/minute

# --- GeoIP (optional). Place GeoLite2-City.mmdb in ./geoip and set path ---
GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb

# --- Frontend (Vite, build-time). Prefix MUST be VITE_ ---
VITE_API_URL=http://localhost:8080/api
# Same value as ACCOUNTS_URL (inlined into the web bundle)
VITE_ACCOUNTS_URL=http://localhost:8085
VITE_SHORT_DOMAIN=localhost:8080
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_REVENUECAT_PUBLIC_KEY=
VITE_BILLING_ENABLED=true
# Apps index linked from the footer (same across all 3m4 apps)
VITE_INFO_URL=https://info.3m4.net
# retro feedback widget (https://retro.3m4.net): the project's PUBLIC key. Empty = no widget.
VITE_RETRO_PROJECT_KEY=
VITE_RETRO_WIDGET_URL=https://retro.3m4.net/widget.js
# metrics web analytics (https://metrics.3m4.net): the project's PUBLIC key. Empty = no tracker.
VITE_METRICS_PROJECT_KEY=
VITE_METRICS_TRACKER_URL=https://metrics.3m4.net/m.js
# oops error tracking (https://oops.3m4.net): the project's PUBLIC key. Empty = no SDK.
VITE_OOPS_PROJECT_KEY=
VITE_OOPS_SDK_URL=https://oops.3m4.net/o.js
VITE_OOPS_ENV=production
