# ─── 3m4 environment ─────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.

# --- Core / database ---
DATABASE_URL=postgresql+psycopg://shortlink:shortlink@postgres:5432/shortlink
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-access-secret
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Privacy ---
# Salt for hashing visitor IPs. We NEVER store raw IPs. Rotate => geo dedup resets.
IP_HASH_SALT=change-me-ip-salt

# --- URLs ---
APP_BASE_URL=http://localhost:8080          # apex: landing + short links
DASHBOARD_URL=http://localhost:8080         # app.3m4.net in prod
SHORT_DOMAIN=localhost:8080                 # used to render short URLs

# --- Reserved redirect (also stored in DB seed) ---
RESUME_REDIRECT_URL=https://enrique-magallon.com

# --- Billing (RevenueCat). Self-host: set BILLING_ENABLED=false ---
BILLING_ENABLED=true
REVENUECAT_WEBHOOK_AUTH_TOKEN=change-me-webhook-token
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=

# --- PostHog (optional; no-ops if unset) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Personal API key (scope: feature flags read) enables local evaluation of
# feature flags. Unset => flags use defaults from packages/shared/feature_flags.json.
POSTHOG_PERSONAL_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_PUBLIC_API=60/minute

# --- GeoIP (optional). Place GeoLite2-City.mmdb in ./geoip and set path ---
GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb

# --- Frontend (Vite, build-time). Prefix MUST be VITE_ ---
VITE_API_URL=http://localhost:8080/api
VITE_SHORT_DOMAIN=localhost:8080
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_REVENUECAT_PUBLIC_KEY=
VITE_BILLING_ENABLED=true
